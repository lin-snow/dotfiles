{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "source": "Apple",
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "key": {
            "width": 9
        }
    },
    "modules": [
        "break",
        "title",
        {
            "type": "os",
            "key": "os",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": "kernel",
            "keyColor": "green"
        },
        {
            "type": "host",
            "key": "host",
            "keyColor": "yellow",
            "format": "{family}"
        },
        {
            "type": "uptime",
            "key": "uptime",
            "keyColor": "blue",
            "format": "{?days}{days}d {?}{hours}h {minutes}m"
        },
        {
            "type": "packages",
            "key": "pkgs",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": "shell",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": "term",
            "keyColor": "red"
        },
        {
            "type": "cpu",
            "key": "cpu",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "gpu",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": "memory",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": "disk",
            "keyColor": "magenta",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": "battery",
            "keyColor": "cyan"
        },
        {
            "type": "localip",
            "key": "ip",
            "keyColor": "red"
        },
        "break"
    ]
}
